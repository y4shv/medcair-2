rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each patient can read and write only their own health document.
    match /user_files/{uid}/files/{fileId} {
      // Uploaded documents (stored as pieces, see lib/health/files.ts).
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Short share links. Anyone with the random id can read one that has not been stopped;
    // nobody can list them. Only the owner can create, stop or delete.
    match /shares/{id} {
      allow get: if resource.data.revoked == false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /health_data/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
